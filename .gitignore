# --- Data, indexes, results: DVC-tracked or regenerated, never in git ---
data/**
!data/**/.gitkeep
!data/**/*.dvc          # DVC pointers MUST be committed (W5)
!data/**/.gitignore
indexes/**
!indexes/.gitkeep
results/**/artifacts/   # metrics.json and the resolved config DO get committed
audit_report.json

# --- Private: never leaves this machine (README rule 4) ---
batches/**
!batches/.gitkeep

# --- Papers: copyrighted PDFs, and large. Cite them, don't redistribute them ---
literature/**
!literature/.gitkeep

# --- Model weights and index binaries ---
*.pt
*.faiss

# --- Environments and caches ---
__pycache__/
.venv/
.env

# --- Editor / agent scratch ---
.claude/scheduled_tasks.lock
.write_test

# --- Thesis docs ---
# Excluded only because the remote is public. Delete this line once the
# repository is private — the docs belong in the repo with the code.
docs/
